rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to get user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        getUserData().companyId == companyId
      );
    }

    function isCompanyOwner(companyId) {
      return isAuthenticated() && (
        getUserData().companyId == companyId &&
        (getUserData().role == 'COMPANY_OWNER' || getUserData().role == 'SUPER_ADMIN')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId);
      allow delete: if false; // User accounts are preserved for audit
    }

    // Companies collection (Multi-tenant core)
    match /companies/{companyId} {
      // Any authenticated user can create a company during initial registration
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Can only be read if the user is a registered member or owner of the tenant
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isCompanyMember(companyId)
      );

      // Only company owner or super admin can update company info
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isCompanyOwner(companyId)
      );

      // Prevent accidental tenant destruction
      allow delete: if false;
    }

    // CompanyUsers junction collection (Tenant Membership & RBAC mapping)
    match /companyUsers/{companyUserId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCompanyMember(resource.data.companyId)
      );

      // Can create on initial owner registration or by company owner
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isCompanyOwner(request.resource.data.companyId)
      );

      allow update: if isAuthenticated() && isCompanyOwner(resource.data.companyId);
      allow delete: if isAuthenticated() && isCompanyOwner(resource.data.companyId);
    }

    // Audit logs collection (Tenant Scoped)
    match /tenantAuditLogs/{logId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Logs are strictly append-only
    }
  }
}
